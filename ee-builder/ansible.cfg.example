# Galaxy server configuration for building this EE.
#
# Copy to `ansible.cfg`, replace the token placeholder, and chmod 0600.
# `ansible.cfg` is gitignored -- never commit the real token.
#
# Generate an offline token at: https://access.redhat.com/management/api
# Note: console.redhat.com *service accounts* (client_id + client_secret) do NOT
# work here -- ansible-core's KeycloakToken only implements the refresh_token
# grant, so an offline token is required.

[galaxy]
# Order matters: ansible-galaxy queries left to right and takes the first hit,
# so certified builds win over community ones where both exist.
server_list = automation_hub, galaxy

[galaxy_server.automation_hub]
url = https://console.redhat.com/api/automation-hub/content/published/
auth_url = https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token
token = <YOUR_OFFLINE_TOKEN>

[galaxy_server.galaxy]
url = https://galaxy.ansible.com/
